# --- secrets ---
.env
.env.*
!.env.example

# --- audio and datasets ---
# Source recordings and derived chunks stay local. Provenance lives in the
# manifests, which are tracked; the audio itself is not redistributed.
data/**
# Directories must be re-included first, or git never descends into them and
# every negation below is silently dead.
!data/**/
!data/**/.gitkeep
# The dataset card travels with the repo; the manifest does not. It holds the
# corpus transcripts themselves, which are CC BY-NC-SA material that this repo
# has no need to redistribute, and it is regenerated by scripts/corpus_qa.py.
!data/speedia/DATASET_CARD.md
!data/story/narration_manifest.json

*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus

# --- model weights and adapters ---
models/**
!models/.gitkeep
*.safetensors
*.bin
*.ckpt
*.pt
*.pth

# --- generated narration ---
# Tracked for the same reason as the clips: Render serves the static site from
# the repo, so an uncommitted mp3 404s in the browser. These are three short
# English narration files, a few hundred KB in total.
web/assets/audio/**
!web/assets/audio/.gitkeep
!web/assets/audio/*.mp3

# --- demo narration recorded for the walkthrough ---
!web/assets/demo/
!web/assets/demo/*.mp3

# --- story clips served by the deployed reader ---
# Deliberately tracked. Render serves the static site straight from the repo,
# so a clip that is not committed 404s in the browser. These are the handful of
# utterances the storybook quotes, redistributed under the corpus's CC BY-NC-SA
# licence with attribution and share-alike carried on the page itself.
!web/assets/clips/
!web/assets/clips/*.wav

# --- reports: keep written reports, drop raw run dumps ---
reports/**
!reports/.gitkeep
!reports/benchmark.md
!reports/train_log.jsonl

# --- python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- os / editor ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- archives (corpus downloads) ---
*.zip
*.tar.gz

# --- ONNX export artefacts (regenerated, hundreds of MB) ---
models/homespun-merged/
models/homespun-onnx/
